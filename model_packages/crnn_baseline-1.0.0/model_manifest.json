{
  "schema_version": 1,
  "model_id": "crnn_baseline",
  "model_version": "1.0.0",
  "model_type": "crnn_mask",
  "model_file": "model.onnx",
  "model_sha256": "6ced76fabbebdcff831f5fbcf29b5654d3a99a88332e11c31044b62fff13b485",
  "input_name": "log_mel",
  "output_name": "logits",
  "input_dtype": "float32",
  "input_axes": ["batch", "channel", "mel", "frame"],
  "output_axes": ["batch", "frame"],
  "preprocessing": {
    "version": "logmel_torchaudio_v1",
    "sample_rate": 16000,
    "channel_policy": "mean",
    "resampling_method": "sinc_interp_hann",
    "resampling_lowpass_filter_width": 6,
    "resampling_rolloff": 0.99,
    "max_duration_seconds": 6.0,
    "overlong_policy": "truncate",
    "padding_policy": "right_zero",
    "n_fft": 400,
    "win_length": 400,
    "hop_length": 160,
    "n_mels": 64,
    "f_min": 0.0,
    "f_max": 8000.0,
    "window": "hann_periodic",
    "center": false,
    "stft_pad": 0,
    "power": 2.0,
    "mel_scale": "htk",
    "mel_norm": null,
    "log_floor": 1e-8,
    "normalization": "per_example_valid_frames",
    "std_correction": 1
  },
  "decoder": {
    "version": "crnn_mask_longest_v1",
    "threshold": 0.5,
    "bridge_ms": 200,
    "interval_policy": "longest_run_first_on_tie",
    "empty_positive_policy": "error"
  }
}
